# ==============================================================================
# Frontend environment variables — template
# ==============================================================================
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real values.
#
# IMPORTANT: NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD
# time, not read at runtime. Changing one in the Vercel dashboard has no effect
# until the project is redeployed. They are also readable by anyone who opens
# devtools — never put a secret behind the NEXT_PUBLIC_ prefix.
# ==============================================================================

# Base URL of the Spring Boot REST API.
#
# MUST include the /api/v1 suffix. lib/apiClient.ts appends bare paths such as
# "/contact" straight onto this value, so omitting the prefix produces requests
# to <host>/contact, which 404 in production.
#
#   Local development : http://localhost:8080/api/v1
#   Render (default)  : https://saturn-rnd-backend.onrender.com/api/v1
#   Custom domain     : https://api.saturn-rnd.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
